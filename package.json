{
  "name": "socketguard",
  "version": "0.3.0",
  "description": "Scan and runtime-guard MCP servers before you trust them with your files and credentials",
  "type": "module",
  "bin": {
    "socketguard": "./dist/cli.js"
  },
  "main": "./dist/scan.js",
  "exports": {
    ".": "./dist/scan.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-db.mjs",
    "prepare": "npm run build",
    "scan": "node dist/cli.js scan",
    "smoke:wrap": "npm run build && node scripts/smoke-wrap.mjs",
    "smoke:profile": "npm run build && node scripts/smoke-profile.mjs",
    "smoke": "npm run smoke:wrap && npm run smoke:profile",
    "pack:check": "npm run build && npm pack --dry-run",
    "dev": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build && npm run smoke:wrap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Applied-AI-Solutions-hub/socketguard.git"
  },
  "bugs": {
    "url": "https://github.com/Applied-AI-Solutions-hub/socketguard/issues"
  },
  "homepage": "https://github.com/Applied-AI-Solutions-hub/socketguard#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "ai-agent",
    "hermes",
    "openclaw",
    "model-context-protocol"
  ],
  "author": "Applied AI Solutions",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "json5": "^2.2.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
