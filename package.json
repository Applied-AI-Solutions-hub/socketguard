{
  "name": "socketguard",
  "version": "0.3.0",
  "description": "Scan and runtime-guard MCP servers before you trust them with your files and credentials",
  "type": "module",
  "bin": {
    "socketguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/db"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-db.mjs",
    "scan": "node dist/cli.js scan",
    "smoke:wrap": "npm run build && node scripts/smoke-wrap.mjs",
    "smoke:profile": "npm run build && node scripts/smoke-profile.mjs",
    "dev": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "ai-agent",
    "hermes",
    "openclaw"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "json5": "^2.2.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
